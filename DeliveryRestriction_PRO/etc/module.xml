<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <!--
        setup_version omitted — this module uses declarative schema (db_schema.xml),
        which is the correct approach for Magento 2.3+. InstallSchema is not used.
    -->
    <module name="Custom_DeliveryRestriction">
        <sequence>
            <module name="Magento_Catalog"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Config"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Email"/>
            <module name="Magento_Ui"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Payment"/>
            <module name="Magento_OfflinePayments"/>
        </sequence>
    </module>
</config>
