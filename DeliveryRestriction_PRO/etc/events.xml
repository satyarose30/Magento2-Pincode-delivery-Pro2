<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="custom_delivery_restriction_validate_zip_on_order"
                  instance="Custom\DeliveryRestriction\Observer\ValidateZipOnOrderPlace"/>
    </event>
    <event name="payment_method_is_active">
        <observer name="custom_delivery_restriction_restrict_payment_by_zip"
                  instance="Custom\DeliveryRestriction\Observer\RestrictPaymentByZip"/>
    </event>
</config>
