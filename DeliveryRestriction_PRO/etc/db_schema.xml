<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="custom_dr_zipcode" resource="default" engine="innodb"
           comment="Custom Delivery Restriction — Managed Zip Codes">

        <column xsi:type="int"       name="zipcode_id"         nullable="false" identity="true" unsigned="true" comment="Primary Key"/>
        <column xsi:type="varchar"   name="zip_code"           nullable="false" length="20"    comment="Zip / Postal Code (exact, wildcard 100*, or range 10000-10099)"/>
        <column xsi:type="varchar"   name="restriction_type"   nullable="false" length="10"    default="blacklist" comment="blacklist or whitelist"/>
        <column xsi:type="smallint"  name="status"             nullable="false" unsigned="true" default="1" comment="1=Active 0=Disabled"/>
        <column xsi:type="text"      name="customer_group_ids" nullable="true"                 comment="Comma-separated customer group IDs; NULL = all groups"/>
        <column xsi:type="text"      name="category_ids"       nullable="true"                 comment="Comma-separated category IDs; NULL = all categories"/>
        <column xsi:type="varchar"   name="store_ids"          nullable="true"  length="255"   comment="Comma-separated store IDs; NULL = all stores"/>
        <column xsi:type="varchar"   name="description"        nullable="true"  length="255"   comment="Admin notes — not shown to customers"/>
        <column xsi:type="int"       name="sort_order"         nullable="false" unsigned="true" default="0" comment="Sort order for rule priority"/>
        <column xsi:type="smallint"  name="cod_restricted"           nullable="false" unsigned="true" default="0" comment="1=COD not available for this zip"/>
        <column xsi:type="smallint"  name="partial_payment_eligible" nullable="false" unsigned="true" default="0" comment="1=Partial/installment payment available for this zip"/>
        <column xsi:type="timestamp" name="created_at"         nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at"         nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="zipcode_id"/>
        </constraint>

        <!-- High-frequency lookup indexes (resolves CODE_REVIEW: add DB indexes) -->
        <index referenceId="CUSTOM_DR_ZIPCODE_ZIP_CODE" indexType="btree">
            <column name="zip_code"/>
        </index>
        <index referenceId="CUSTOM_DR_ZIPCODE_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="CUSTOM_DR_ZIPCODE_STATUS_TYPE" indexType="btree">
            <column name="status"/>
            <column name="restriction_type"/>
        </index>
        <index referenceId="CUSTOM_DR_ZIPCODE_SORT" indexType="btree">
            <column name="sort_order"/>
        </index>
    </table>

</schema>
